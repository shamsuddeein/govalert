# ─────────────────────────────────────────────────────────────────────────────
# GovAlert Fullstack Configuration (Turso + Vercel)
# ─────────────────────────────────────────────────────────────────────────────

# Database (Turso libSQL)
# For local dev: leave empty or use file:./users.db
# For production on Vercel: use your Turso database credentials from https://turso.tech/
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI Recruitment Verification & Trust Engine (OpenAI)
# Optional for local (falls back to rule-based trust evaluator)
# Required on Vercel for GPT-4o-mini structured analysis
OPENAI_API_KEY=

# Telegram Bot Integration
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=
TELEGRAM_CHANNEL_ID=@GovAlertNigeria

# Cron Security (Optional)
CRON_SECRET=
